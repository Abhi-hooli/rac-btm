rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read-only collections ──────────────────────────────────────
    match /projects/{doc}    { allow read: if true; allow write: if request.auth != null; }
    match /events/{doc}      { allow read: if true; allow write: if request.auth != null; }
    match /leaders/{doc}     { allow read: if true; allow write: if request.auth != null; }
    match /gallery/{doc}     { allow read: if true; allow write: if request.auth != null; }
    match /testimonials/{doc}{ allow read: if true; allow write: if request.auth != null; }
    match /blogs/{doc}       { allow read: if true; allow write: if request.auth != null; }
    match /settings/{doc}    { allow read: if true; allow write: if request.auth != null; }
    match /partners/{doc}    { allow read: if true; allow write: if request.auth != null; }
    match /impact/{doc}      { allow read: if true; allow write: if request.auth != null; }
    match /milestones/{doc}  { allow read: if true; allow write: if request.auth != null; }
    match /archives/{doc}    { allow read: if true; allow write: if request.auth != null; }

    // ── RSVP — public write (anyone can RSVP), admin read ────────────────
    match /rsvps/{doc} {
      allow read:  if request.auth != null;
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254;
      allow update, delete: if request.auth != null;
    }

    // ── Newsletter subscribers — public create, admin read/delete ────────
    match /subscribers/{doc} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() <= 254;
      allow read, update, delete: if request.auth != null;
    }

    // ── Contact form — public create, admin read ──────────────────────────
    match /contacts/{doc} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }

    // ── Membership applications — public create, admin read/manage ───────
    match /membershipApplications/{doc} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254;
      allow read, update, delete: if request.auth != null;
    }

    // ── Club documents — public docs readable by anyone, admin-only docs need auth ──
    match /club_documents/{doc} {
      allow read: if resource.data.isPublic == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Admin-only collections ────────────────────────────────────────────
    match /users/{doc}              { allow read, write: if request.auth != null; }
    match /attendance_meetings/{doc}{ allow read, write: if request.auth != null; }
    match /treasury/{doc}           { allow read, write: if request.auth != null; }
    match /treasurer_members/{doc}       { allow read, write: if request.auth != null; }
    match /treasurer_events/{doc}        { allow read, write: if request.auth != null; }
    match /treasurer_sponsorships/{doc}  { allow read, write: if request.auth != null; }
    match /treasurer_transactions/{doc}  { allow read, write: if request.auth != null; }
    match /treasurer_assets/{doc}        { allow read, write: if request.auth != null; }
    match /moms/{doc}          { allow read, write: if request.auth != null; }
    match /auditLog/{doc}      { allow read, write: if request.auth != null; }
    match /emailReminders/{doc}{ allow read, write: if request.auth != null; }

    // ── Link redirects — public read (to resolve /r/:slug), admin write ───
    match /links/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // ── Link click tracking — public create (visitor hits), admin read ───
    match /linkClicks/{doc} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.linkId is string;
      allow update, delete: if request.auth != null;
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
